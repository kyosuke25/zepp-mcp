{
  "name": "zepp-mcp",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "fixture": "tsx scripts/decode-fixture.ts",
    "pretest": "npm run build",
    "poc": "node --env-file-if-exists=.dev.vars scripts/poc.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "miniflare": "5.20261113.0-beta",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "wrangler": "4.162.0"
  }
}
